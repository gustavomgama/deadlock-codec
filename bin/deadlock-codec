#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/deadlock_codec"

usage = <<~USAGE
  Usage:
    deadlock-codec decode <code>        Print decoded build as JSON
    deadlock-codec encode <file.json>    Read JSON file, print encoded code
USAGE

command = ARGV.shift
case command
when "decode"
  code = ARGV.join
  abort "missing code" if code.empty?
  puts JSON.pretty_generate(DeadlockCodec.decode(code))
when "encode"
  path = ARGV.shift
  abort "missing file" unless path
  json = JSON.parse(File.read(path), symbolize_names: true)
  puts DeadlockCodec.encode(json)
else
  puts usage
  exit 1
end
